{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-native",
    "paths": {
      "#/*": [
        "./src/*"
      ],
      "@bsky.app/expo-bluesky-swiss-army": [
        "./modules/expo-bluesky-swiss-army"
      ],
      "@bsky.app/expo-bluesky-swiss-army/*": [
        "./modules/expo-bluesky-swiss-army/*"
      ],
      "@bsky.app/expo-bluesky-gif-view": [
        "./modules/expo-bluesky-gif-view"
      ],
      "@bsky.app/expo-bluesky-gif-view/*": [
        "./modules/expo-bluesky-gif-view/*"
      ],
      "@bsky.app/expo-orbis-swiss-army": [
        "./modules/expo-bluesky-swiss-army"
      ],
      "@bsky.app/expo-orbis-swiss-army/*": [
        "./modules/expo-bluesky-swiss-army/*"
      ]
    },
    "skipLibCheck": true
  },
  "include": [
    "src",
    "modules",
    "index.ts",
    "index.web.ts"
  ],
  "exclude": [
    "node_modules",
    "bskyembed",
    "bskylink",
    "bskyogcard",
    "dev-env",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/__tests__/**"
  ]
}
